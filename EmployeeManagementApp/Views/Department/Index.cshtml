@{
    ViewData["Title"] = "Departments";
}

<div class="card">
    <div class="card-header d-flex justify-content-end align-items-center">
        @* <h3 class="card-title">All Departments</h3> *@
        <button type="button" class="btn btn-success btn-sm" id="btnAddDepartment">
            <i class="fas fa-plus"></i> Add Department
        </button>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-striped" id="departmentsTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Manager</th>
                    <th>Budget</th>
                    <th>Employee Count</th>
                    <th style="width:150px;">Action</th>
                </tr>
            </thead>
            <tbody id="departmentsTableBody">
                <!-- rows injected by Departments.js -->
            </tbody>
        </table>
    </div>
</div>

<!-- Add/Edit Department Modal -->
<div class="modal fade" id="departmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="departmentModalTitle">Add Department</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="departmentId" />
                <div class="form-group">
                    <label>Department Name</label>
                    <input type="text" class="form-control" id="departmentName" placeholder="e.g. IT" />
                </div>
                <div class="form-group">
                    <label>Manager</label>
                    <input type="text" class="form-control" id="departmentManager" placeholder="e.g. Rajesh Kumar" />
                </div>
                <div class="form-group">
                    <label>Budget</label>
                    <input type="number" class="form-control" id="departmentBudget" placeholder="e.g. 500000" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveDepartment">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootbox/bootbox.min.js"></script>
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/Department.js" asp-append-version="true"></script>
}