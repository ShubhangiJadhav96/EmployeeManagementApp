    <!-- Sidebar menu search/filter -->
    <script>
        $(function () {
        var $sidebarSearchInput = $('.form-control-sidebar');
        var $topNavItems = $('.nav-sidebar > .nav-item');

        function resetSidebar() {
        $topNavItems.show();
        $('.nav-sidebar .nav-treeview > .nav-item').show();
        $('.nav-sidebar > .nav-item.menu-open').removeClass('menu-open')
        .find('> .nav-treeview').css('display', '');
        }

        $sidebarSearchInput.on('input', function () {
        var query = $(this).val().trim().toLowerCase();

        if (query === '') {
        resetSidebar();
        return;
        }

        $topNavItems.each(function () {
        var $parent = $(this);
        var parentText = $parent.children('.nav-link').find('p').first()
        .clone().children().remove().end().text().trim().toLowerCase();
        var $children = $parent.find('.nav-treeview > .nav-item');
        var parentMatches = parentText.indexOf(query) !== -1;
        var anyChildMatches = false;

        $children.each(function () {
        var $child = $(this);
        var childText = $child.find('.nav-link p').text().trim().toLowerCase();
        var childMatches = childText.indexOf(query) !== -1;
        $child.toggle(childMatches);
        if (childMatches) anyChildMatches = true;
        });

        if (parentMatches || anyChildMatches) {
        $parent.show();
        if (anyChildMatches) {
        $parent.addClass('menu-open').find('> .nav-treeview').css('display', 'block');
        }
        } else {
        $parent.hide();
        }
        });
        });
        });
    </script>

